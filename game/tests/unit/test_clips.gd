extends TestCase
## Mixamo pipeline: clips in Mixamo's format (fixtures generated by
## art/blender/make_mixamo_fixtures.py), retargeted at import by
## tools/setup_mixamo.gd, playing on the real default VRM character.

const Scene := preload("res://scenes/training_ground.tscn")
const FIXTURES := "res://tests/fixtures/mixamo"

var model: CharacterModel
var scene: Node3D


func before_each() -> void:
	model = CharacterModel.new()
	model.model_path = CharacterModel.DEFAULT_MODEL
	model.clip_dir = FIXTURES
	root.add_child(model)


func after_each() -> void:
	if is_instance_valid(model):
		model.queue_free()
	if is_instance_valid(scene):
		scene.queue_free()
	# The player test borrows the default clip folder's library.
	CharacterAnimator._library_cache.erase(CharacterAnimator.CLIP_DIR)


func _frames(n: int) -> void:
	for i in n:
		await root.get_tree().process_frame


func _bone(bone: StringName) -> Vector3:
	var skel := model.skeleton
	return model.to_local(skel.global_transform * skel.get_bone_global_pose(skel.find_bone(bone)).origin)


func _posed() -> void:
	await model.skeleton.skeleton_updated


func test_bone_map_covers_mixamo_skeleton() -> void:
	var map: BoneMap = load("res://assets/animations/mixamo_bone_map.tres")
	assert_true(map.profile is SkeletonProfileHumanoid)
	assert_eq(map.get_skeleton_bone_name(&"LeftUpperArm"), &"mixamorig_LeftArm")
	assert_eq(map.get_skeleton_bone_name(&"Chest"), &"mixamorig_Spine1")
	assert_eq(map.get_skeleton_bone_name(&"RightToes"), &"mixamorig_RightToeBase")


func test_fixture_clips_are_retargeted_and_loaded() -> void:
	var lib := CharacterAnimator.load_library(FIXTURES)
	assert_true(lib.has_animation(&"idle") and lib.has_animation(&"run"), "both clips loaded")
	var run := lib.get_animation(&"run")
	assert_true(String(run.track_get_path(0)).begins_with("%GeneralSkeleton:"), "humanoid track paths")
	assert_eq(run.loop_mode, Animation.LOOP_LINEAR)


func test_clips_take_over_locomotion() -> void:
	var anim := model.animator
	assert_true(anim.clips != null, "clip player created")
	assert_true(model.poser.clip_states.has(HumanoidPoser.Pose.LOCOMOTION))
	assert_false(model.poser.clip_states.has(HumanoidPoser.Pose.GUARD), "no guard clip -> procedural guard")
	# A jog's pace (the game's full run speed takes the sprint gait).
	anim.speed_ratio = 0.5
	await root.get_tree().process_frame
	await root.get_tree().process_frame
	assert_eq(anim.clips.current_animation, &"run")
	anim.speed_ratio = 0.0
	await root.get_tree().process_frame
	assert_eq(anim.clips.current_animation, &"idle")


func test_run_clip_moves_the_vrm_legs() -> void:
	model.animator.speed_ratio = 1.0
	var min_z := INF
	var max_z := -INF
	var hips_y := 0.0
	for i in 60:
		await _posed()
		var z := _bone(&"LeftFoot").z - _bone(&"RightFoot").z
		min_z = minf(min_z, z)
		max_z = maxf(max_z, z)
		hips_y = _bone(&"Hips").y
		# Retargeting must not flip or twist the legs above the hips.
		assert_true(_bone(&"LeftFoot").y < hips_y, "foot stays below hips")
	assert_true(max_z - min_z > 0.1, "feet swing past each other (%.2f)" % (max_z - min_z))


func test_hand_seals_layer_over_clips() -> void:
	model.animator.pose = HumanoidPoser.Pose.WEAVE
	for i in 40:
		await root.get_tree().process_frame
	await _posed()
	var arm := _bone(&"LeftUpperArm").distance_to(_bone(&"LeftLowerArm")) \
		+ _bone(&"LeftLowerArm").distance_to(_bone(&"LeftHand"))
	assert_true(_bone(&"LeftHand").distance_to(_bone(&"RightHand")) < 0.2 * arm, "palms together over idle clip")
	assert_eq(model.animator.clips.current_animation, &"idle", "legs still from the clip")


# --- A Mixamo jump, split into phases (JumpClip) -----------------------------------
# The fixture is a standing leap built like Mixamo's "Jumping": its hips carry the
# whole jump's height. art/blender/make_mixamo_fixtures.py says when each part
# happens (JUMP_FRAMES, 30 fps).

## A folder with the same jump and a land.fbx of its own, and one that is not there.
const FIXTURES_LAND := "res://tests/fixtures/mixamo_land"
const NO_CLIPS := "res://tests/fixtures/no_clips_here"
const JUMP_PHASES := {"crouch": 18, "toes_off": 27, "peak": 35, "touchdown": 43, "bottom": 51}


## Seconds into the jump clip for a frame of its timeline.
func _at(frame: int) -> float:
	return (frame - 1) / 30.0


## A model on the clips in `dir`, settled.
func _model_with(dir: String) -> CharacterModel:
	model.queue_free()
	model = CharacterModel.new()
	model.model_path = CharacterModel.DEFAULT_MODEL
	model.clip_dir = dir
	root.add_child(model)
	await _frames(3)
	return model


func test_the_phases_of_a_jump_are_found_in_order_and_where_they_happen() -> void:
	var found := JumpClip.phases_of(FIXTURES + "/jump.fbx")
	assert_false(found.is_empty(), "a jump was found")
	for phase: String in JUMP_PHASES:
		assert_near(found[phase], _at(JUMP_PHASES[phase]), 0.08, "%s (frame %d)" % [phase, JUMP_PHASES[phase]])
	var takeoff: Vector2 = found["takeoff"]
	var air: Vector2 = found["air"]
	var land: Vector2 = found["land"]
	assert_true(found["crouch"] < takeoff.x, "the push-off starts after the deepest crouch")
	assert_true(takeoff.x < found["toes_off"] and found["toes_off"] < takeoff.y, "the push-off spans the toes leaving")
	assert_near(takeoff.y, air.x, 0.001, "the air takes over where the push-off ends")
	assert_true(air.x < found["peak"] and found["peak"] < air.y, "the peak is in the air")
	assert_near(air.y, land.x, 0.001, "the landing starts at touchdown")
	assert_true(land.x < found["bottom"] and found["bottom"] < land.y, "the landing runs through the deepest crouch")
	assert_true(takeoff.y - takeoff.x < 0.4, "the push-off is short")


func test_a_clip_with_no_leap_in_it_is_left_alone() -> void:
	# The fixture's run keeps both feet down.
	var run := JumpClip.find_phases(CharacterAnimator.load_library(FIXTURES).get_animation(&"run"),
		JumpClip.phases_of(FIXTURES + "/jump.fbx")["rig"])
	assert_true(run.is_empty(), "no air in a run")


func test_the_air_clip_has_no_hip_movement_but_keeps_the_hips_turning() -> void:
	var lib := CharacterAnimator.load_library(FIXTURES)
	var source := JumpClip.phases_of(FIXTURES + "/jump.fbx")["anim"] as Animation
	var hips := NodePath("%GeneralSkeleton:Hips")
	var source_pos := source.find_track(hips, Animation.TYPE_POSITION_3D)
	var rise := 0.0
	for k in source.track_get_key_count(source_pos):
		rise = maxf(rise, (source.track_get_key_value(source_pos, k) as Vector3).y - (source.track_get_key_value(source_pos, 0) as Vector3).y)
	assert_true(rise > 0.3, "the whole jump's hips rise (%.2f)" % rise)
	for clip: StringName in [&"jump", &"jump_takeoff"]:
		var anim := lib.get_animation(clip)
		var pos := anim.find_track(hips, Animation.TYPE_POSITION_3D)
		assert_true(pos >= 0, "%s still sets the hips' position, to a fixed one" % clip)
		var first := anim.position_track_interpolate(pos, 0.0)
		for at in [anim.length * 0.3, anim.length * 0.7, anim.length - 0.01]:
			assert_true(anim.position_track_interpolate(pos, at).is_equal_approx(first), "%s: hips stay put at %.2f s" % [clip, at])
		var rot := anim.find_track(hips, Animation.TYPE_ROTATION_3D)
		assert_true(rot >= 0 and anim.track_get_key_count(rot) >= 2, "%s keeps the hips' rotation" % clip)
	# The push-off's hips lean in out of the crouch; the rest is straight.
	var takeoff := lib.get_animation(&"jump_takeoff")
	var lean := takeoff.find_track(hips, Animation.TYPE_ROTATION_3D)
	assert_true(takeoff.rotation_track_interpolate(lean, 0.0).angle_to(takeoff.rotation_track_interpolate(lean, takeoff.length)) > 0.05,
		"the hips' own turn is the clip's")
	# Landing is on the ground: its hips drop into the crouch.
	var land := lib.get_animation(&"land")
	var land_pos := land.find_track(hips, Animation.TYPE_POSITION_3D)
	var top := (land.track_get_key_value(land_pos, 0) as Vector3).y
	var bottom := top
	for k in land.track_get_key_count(land_pos):
		bottom = minf(bottom, (land.track_get_key_value(land_pos, k) as Vector3).y)
	assert_true(top - bottom > 0.3, "the landing crouches (%.2f)" % (top - bottom))


func test_the_split_clips_are_what_the_library_holds() -> void:
	var lib := CharacterAnimator.load_library(FIXTURES)
	for clip: StringName in [&"jump_takeoff", &"jump", &"land"]:
		assert_true(lib.has_animation(clip), "%s is there" % clip)
		assert_true(String(lib.get_animation(clip).track_get_path(0)).begins_with("%GeneralSkeleton:"), "%s is retargeted" % clip)
	assert_eq(lib.get_animation(&"jump").get_meta(JumpClip.PHASE), &"air")
	assert_eq(lib.get_animation(&"jump_takeoff").get_meta(JumpClip.PHASE), &"takeoff")
	assert_eq(lib.get_animation(&"land").get_meta(JumpClip.PHASE), &"land")
	assert_eq(lib.get_animation(&"jump_takeoff").loop_mode, Animation.LOOP_NONE)
	assert_eq(lib.get_animation(&"land").loop_mode, Animation.LOOP_NONE)
	assert_true(lib.get_animation(&"jump_takeoff").length < 0.4, "a short push-off")
	assert_true(lib.get_animation(&"land").length > 0.3, "the whole landing crouch")


func test_a_land_clip_of_its_own_wins_over_the_jumps_landing() -> void:
	var lib := CharacterAnimator.load_library(FIXTURES_LAND)
	assert_true(lib.has_animation(&"jump_takeoff") and JumpClip.is_air(lib.get_animation(&"jump")), "the jump is still split")
	assert_false(lib.get_animation(&"land").has_meta(JumpClip.PHASE), "the land.fbx is the landing")
	assert_near(lib.get_animation(&"land").length, 23.0 / 30.0, 0.05, "the file's own length")


func test_the_air_pose_follows_the_climb_and_the_fall() -> void:
	var air := CharacterAnimator.load_library(FIXTURES).get_animation(&"jump")
	var peak: float = air.get_meta(JumpClip.PEAK)
	var down: float = air.get_meta(JumpClip.TOUCHDOWN)
	assert_true(peak > 0.05 and peak < down and down < air.length, "start < peak < touchdown < end (%.2f %.2f %.2f)" % [peak, down, air.length])
	assert_near(JumpClip.air_time(air, JumpClip.RISE_SPEED), 0.0, 0.0001, "leaving the ground")
	assert_near(JumpClip.air_time(air, 20.0), 0.0, 0.0001, "no earlier than the start")
	assert_near(JumpClip.air_time(air, 0.0), peak, 0.0001, "at the top")
	assert_near(JumpClip.air_time(air, -JumpClip.FALL_SPEED), down, 0.0001, "coming down")
	assert_near(JumpClip.air_time(air, -30.0), down, 0.0001, "a long fall stays reaching for the ground")
	assert_true(JumpClip.air_time(air, 4.0) < peak and JumpClip.air_time(air, -3.0) > peak, "climbing before the peak, falling after")


func test_in_the_air_the_clip_flies_the_body_and_the_poser_leaves_the_legs_to_it() -> void:
	var anim := model.animator
	await _frames(3)
	assert_true(anim.has_jump_phases() and model.poser.clip_air, "the poser knows the clip covers the air")
	anim.follows_body = false
	anim.vertical_speed = 8.0
	anim.airborne = true
	await _frames(3)
	assert_eq(anim.current_clip(), &"jump", "the air phase plays")
	var rising := anim.clips.current_animation_position
	var p := model.poser._target_params()
	assert_false(p["use_legs"], "the legs are the clip's")
	assert_false(p["use_spine"], "so is the spine")
	assert_false(p["use_arms"], "and the arms")
	anim.vertical_speed = 0.0
	await _frames(3)
	var top := anim.clips.current_animation_position
	anim.vertical_speed = -8.0
	await _frames(3)
	var falling := anim.clips.current_animation_position
	assert_true(rising < top - 0.05 and top < falling - 0.05, "the pose moves on from rising to the top to falling (%.2f %.2f %.2f)" % [rising, top, falling])
	await seconds(1.0)
	assert_near(anim.clips.current_animation_position, falling, 0.1, "held while the body stays up, however long")
	assert_eq(anim.current_clip(), &"jump")


func test_a_sword_arm_and_a_throw_still_belong_to_the_poser_in_the_air() -> void:
	model.queue_free()
	model = CharacterModel.new()
	model.model_path = CharacterModel.DEFAULT_MODEL
	model.use_profile = false
	model.style = {"back": "ninjato"}
	model.clip_dir = FIXTURES
	root.add_child(model)
	await _frames(3)
	var anim := model.animator
	anim.follows_body = false
	anim.airborne = true
	anim.strike()
	await seconds(HumanoidPoser.DRAW_TIME + 0.1)
	var p := model.poser._target_params()
	assert_true(p["use_arm_R"], "the sword arm is posed")
	assert_false(p["use_legs"], "the legs are still the clip's")
	anim.throw()
	p = model.poser._target_params()
	assert_true(p["use_arms"], "a throw has its arms")
	assert_false(p["use_legs"])


func test_the_push_off_plays_fast_the_moment_a_jump_leaves_the_ground() -> void:
	var anim := model.animator
	await _frames(3)
	assert_eq(anim.current_clip(), &"idle")
	# The body goes up and the feet are off the ground, the same frame (a jump).
	model.position.y = 0.5
	anim.airborne = true
	await _frames(2)
	assert_eq(anim.current_clip(), &"jump_takeoff", "the push-off starts at once")
	assert_near(anim.clips.speed_scale, CharacterAnimator.TAKEOFF_SPEED, 0.001, "and plays fast")
	anim.follows_body = false
	await seconds(0.5)
	assert_eq(anim.current_clip(), &"jump", "then the air")


func test_stepping_off_a_ledge_is_not_a_jump_but_a_second_jump_in_the_air_is() -> void:
	var anim := model.animator
	await _frames(3)
	model.position.y = 0.0
	anim.airborne = true
	await _frames(2)
	assert_eq(anim.current_clip(), &"jump", "a fall without the push-off")
	anim.follows_body = false
	anim.vertical_speed = -3.0
	anim.follows_body = true
	await _frames(2)
	model.position.y += 0.6
	await _frames(2)
	assert_eq(anim.current_clip(), &"jump_takeoff", "kicking off again in mid-air")


func test_landing_plays_the_landing_crouch() -> void:
	var anim := model.animator
	await _frames(3)
	anim.follows_body = false
	anim.airborne = true
	await _frames(3)
	anim.vertical_speed = -8.0
	anim.airborne = false
	assert_eq(anim.current_clip(), &"land", "the landing phase")
	assert_eq(anim.clips.get_animation(&"land").get_meta(JumpClip.PHASE), &"land", "from the jump")
	await _frames(2)
	assert_eq(anim.current_clip(), &"land")
	await seconds(0.5)
	assert_eq(anim.current_clip(), &"idle", "standing up again is the idle's job")


func test_a_running_jump_keeps_the_clip_in_the_air_and_runs_on_landing() -> void:
	var anim := model.animator
	await _frames(3)
	anim.follows_body = false
	for gait: Array in [[0.5, &"run"], [1.0, &"sprint"]]:
		anim.speed_ratio = gait[0]
		await _frames(3)
		assert_eq(anim.current_clip(), gait[1])
		anim.vertical_speed = 3.0
		anim.airborne = true
		await _frames(3)
		assert_eq(anim.current_clip(), &"jump", "the jump clip off a %s" % gait[1])
		var p := model.poser._target_params()
		assert_false(p["use_legs"] or p["use_spine"] or p["use_arms"], "the clip, not the poser, off a %s" % gait[1])
		anim.airborne = false
		await _frames(3)
		assert_eq(anim.current_clip(), gait[1], "no landing crouch: back to the %s" % gait[1])


func test_without_a_mixamo_jump_the_air_is_posed_as_before() -> void:
	await _model_with(NO_CLIPS)
	var anim := model.animator
	assert_false(anim.has_jump_phases(), "no phases")
	assert_false(model.poser.clip_air)
	assert_false(anim.has_clip(&"jump_takeoff"), "no push-off clip")
	var jump := anim.library.get_animation(&"jump")
	assert_false(jump.has_meta(JumpClip.PHASE), "the library's own jump")
	assert_eq(jump.loop_mode, Animation.LOOP_LINEAR)
	anim.airborne = true
	await _frames(3)
	assert_eq(anim.current_clip(), &"jump")
	var p := model.poser._target_params()
	assert_true(p["use_legs"] and p["use_spine"] and p["use_arms"], "tucked by the poser, as before")
	# A rise the same frame the feet leave the ground starts nothing.
	anim.airborne = false
	await seconds(0.5)
	model.position.y = 0.6
	anim.airborne = true
	await _frames(2)
	assert_eq(anim.current_clip(), &"jump")


# --- Sword clips (cut_1 ... cut_4) -------------------------------------------------
# The fixtures hold one: cut_1.fbx, a synthetic swing (a slow wind-up to frame 36,
# the cut in frames 36-42, a slow recovery), the combo's first cut.

## A swordsman in the fixtures' clips, with the sword out in his hand.
func _swordsman() -> CharacterAnimator:
	model.free()
	model = CharacterModel.new()
	model.model_path = CharacterModel.DEFAULT_MODEL
	model.use_profile = false
	model.style = {"back": "ninjato"}
	model.clip_dir = FIXTURES
	root.add_child(model)
	await _frames(2)
	model.animator.strike()
	await seconds(HumanoidPoser.DRAW_TIME + 0.1)
	return model.animator


func test_a_cut_slot_loads_and_is_trimmed_to_the_swing() -> void:
	var lib := CharacterAnimator.load_library(FIXTURES)
	assert_true(lib.has_animation(&"cut_1"), "the slot loads")
	assert_false(lib.has_animation(&"cut_2"), "and the others are empty")
	var clip := lib.get_animation(&"cut_1")
	assert_true(String(clip.track_get_path(0)).begins_with("%GeneralSkeleton:"), "retargeted like any clip")
	assert_eq(clip.loop_mode, Animation.LOOP_NONE, "a cut plays once")
	var source := CharacterAnimator._first_animation(FIXTURES + "/cut_1.fbx")
	assert_near(source.length, 65.0 / 30.0, 0.05, "the fixture is a 2 s clip")
	assert_true(clip.length < 0.7, "of which the cut keeps well under a second (%.2f s)" % clip.length)
	assert_eq(CharacterAnimator.cut_clip_name(0), &"cut_1")
	assert_eq(CharacterAnimator.cut_clip_name(3), &"cut_4")
	assert_eq(CharacterAnimator.cut_clip_name(4), &"cut_1", "the combo wraps")


func test_auto_trim_finds_the_fast_part_and_not_the_wind_up() -> void:
	var source := CharacterAnimator._first_animation(FIXTURES + "/cut_1.fbx")
	var found := SwingClip.window(source)
	var span: Vector2 = found["span"]
	# The cut is frames 36 to 42 (1.17 s to 1.37 s); the wind-up fills the first 1.2 s.
	assert_true(span.x > 1.0, "the wind-up is left out (the window starts at %.2f s)" % span.x)
	assert_true(span.y < 1.6, "so is most of the recovery (it ends at %.2f s)" % span.y)
	assert_true(span.y - span.x < 0.5, "a short window (%.2f s)" % (span.y - span.x))
	assert_true(float(found["peak"]) > 1.15 and float(found["peak"]) < 1.4, "around the peak (%.2f s)" % float(found["peak"]))
	var clip := CharacterAnimator.load_library(FIXTURES).get_animation(&"cut_1")
	var swing: Vector2 = clip.get_meta(SwingClip.META_SWING)
	assert_true(swing.y <= HumanoidPoser.CUT_TIME + 0.02, "the swing fits the game's cut time (%.2f s)" % swing.y)
	assert_true(swing.x > 0.0 and swing.x < 0.12, "after a short lead-in (%.2f s)" % swing.x)
	assert_true(clip.length > swing.y, "and with a settle")


func test_a_standing_cut_plays_its_slot_clip() -> void:
	var anim := await _swordsman()
	var poser := model.poser
	assert_eq(anim.cut_clip(0), &"cut_1", "the slot has a clip and he stands")
	anim.strike(0)
	assert_eq(anim.current_clip(), &"cut_1", "the clip plays")
	assert_true(poser.is_clip_cutting() and poser.is_cutting(), "the poser knows the clip is cutting")
	# The sword arm is the clip's: once the clip has blended in, the arm's
	# rotation is what the clip says it is, not the keys' IK.
	await seconds(0.15)
	await model.skeleton.skeleton_updated
	var clip := anim.library.get_animation(&"cut_1")
	var track := clip.find_track(NodePath("%GeneralSkeleton:RightUpperArm"), Animation.TYPE_ROTATION_3D)
	var want := clip.rotation_track_interpolate(track, anim.clips.current_animation_position)
	var got := model.skeleton.get_bone_pose_rotation(model.skeleton.find_bone(&"RightUpperArm"))
	assert_true(want.angle_to(got) < 0.05, "the upper arm is the clip's (%.3f rad off)" % want.angle_to(got))
	assert_true(model.gear.is_drawn(), "the sword stays in the hand")
	var wrist := BoneAttachment3D.new()
	wrist.bone_name = &"RightHand"
	model.skeleton.add_child(wrist)
	await _frames(2)
	var grip := model.gear.sword.to_global(Vector3(0, CharacterGear.GRIP_Y, 0))
	assert_true(grip.distance_to(wrist.global_position) < 0.15, "the grip is in the fist (%.2f m)" % grip.distance_to(wrist.global_position))
	# When the clip is over the pose has the arm again and the cut is done.
	await seconds(clip.length + 0.4)
	assert_false(poser.is_clip_cutting() or poser.is_cutting(), "the cut is over")
	assert_eq(anim.current_clip(), &"idle", "back to the idle")
	await _frames(2)
	assert_near(poser._clip_w, 0.0, 0.001, "and the pose has the arm back")


func test_a_moving_or_airborne_cut_stays_procedural() -> void:
	var anim := await _swordsman()
	var poser := model.poser
	anim.speed_ratio = 0.5
	await _frames(3)
	assert_eq(anim.cut_clip(0), &"", "no clip on the move")
	anim.strike(0)
	assert_true(poser.is_cutting() and not poser.is_clip_cutting(), "the arms cut")
	assert_eq(anim.current_clip(), &"run", "and the legs keep running")
	anim.speed_ratio = 0.0
	await seconds(HumanoidPoser.CUT_TIME + 0.2)
	anim.airborne = true
	assert_eq(anim.cut_clip(0), &"", "none in the air")
	anim.strike(0)
	assert_true(poser.is_cutting() and not poser.is_clip_cutting(), "the arms cut in the air too")
	assert_true(anim.current_clip() != &"cut_1")
	anim.airborne = false
	anim.pose = HumanoidPoser.Pose.GUARD
	assert_eq(anim.cut_clip(0), &"", "or in another pose")


func test_an_empty_slot_keeps_the_procedural_cut() -> void:
	var anim := await _swordsman()
	var poser := model.poser
	assert_false(anim.has_clip(&"cut_2"))
	assert_eq(anim.cut_clip(1), &"")
	anim.strike(1)
	assert_true(poser.is_cutting() and not poser.is_clip_cutting(), "the keys make the cut")
	assert_eq(anim.current_clip(), &"idle", "no clip plays")
	await _posed()
	assert_true(poser._cur.get("use_arm_L", false), "the free hand is thrown back, as in every keyed cut")
	assert_eq(anim.cut_direction(1), HumanoidPoser.cut_direction(1), "and the sparks follow the keys")


func test_the_blade_trail_emits_through_a_clip_cut() -> void:
	var anim := await _swordsman()
	var trail := model.gear.blade_trail
	await seconds(trail.lifetime + 0.2)
	assert_false(trail.emitting, "quiet after the draw")
	anim.strike(0)
	await seconds(0.1)
	assert_true(model.poser.is_cutting(), "cutting")
	assert_true(trail.emitting and trail.is_showing(), "the blade leaves its ribbon")
	var clip := anim.library.get_animation(&"cut_1")
	await seconds(clip.length + 0.2)
	assert_false(trail.emitting, "and stops when the swing is done")


func test_a_clip_cuts_sparks_follow_the_hand_not_the_keys() -> void:
	var anim := await _swordsman()
	var frame := model.poser.canonical_frame().inverse()
	var wrist := BoneAttachment3D.new()
	wrist.bone_name = &"RightHand"
	model.skeleton.add_child(wrist)
	await _frames(2)
	anim.strike(0)
	var clip := anim.library.get_animation(&"cut_1")
	var swing: Vector2 = clip.get_meta(SwingClip.META_SWING)
	var start := Vector3.INF
	var end := Vector3.ZERO
	var elapsed := 0.0
	while elapsed < swing.y:
		await _posed()
		elapsed = anim.clips.current_animation_position
		var at: Vector3 = frame * (model.skeleton.global_transform.affine_inverse() * wrist.global_position)
		if elapsed >= swing.x and start == Vector3.INF:
			start = at
		end = at
	var moved := Vector2(end.x - start.x, end.y - start.y).normalized()
	var line := anim.cut_direction(0)
	assert_near(line.length(), 1.0, 0.001, "a unit vector")
	assert_eq(line.z, 0.0, "without depth, like the keyed ones")
	assert_true(Vector2(line.x, line.y).dot(moved) > 0.5, "along the way the hand went (%s vs %s)" % [line, moved])
	assert_true(line.distance_to(HumanoidPoser.cut_direction(0)) > 0.01, "not the keyed direction")


func test_a_cut_struck_again_starts_the_clip_over() -> void:
	var anim := await _swordsman()
	anim.strike(0)
	await seconds(0.15)
	assert_true(anim.clips.current_animation_position > 0.05, "well into the clip")
	anim.strike(0)
	assert_true(anim.clips.current_animation_position < 0.02, "the next cut starts it over")
	assert_true(model.poser.is_clip_cutting() and model.poser.is_cutting())


func test_the_combo_keeps_its_cadence_with_a_clip_in_it() -> void:
	# The player's own model takes the default clip folder: borrow the fixtures.
	CharacterAnimator._library_cache[CharacterAnimator.CLIP_DIR] = CharacterAnimator.load_library(FIXTURES)
	scene = Scene.instantiate()
	root.add_child(scene)
	var player: Player = scene.player
	await physics_frames(10)
	var anim := player.animator
	assert_true(anim.has_clip(&"cut_1") and anim.has_sword(), "the player has the clip and a sword")
	player._strike()
	assert_true(anim.poser.is_drawing(), "the first blow still draws")
	await seconds(HumanoidPoser.DRAW_TIME + 0.1)
	var rhythm := player.strike_interval * maxf(0.4, 1.0 - Perks.value(&"strike_speed"))
	var combo: Array[int] = []
	var cooldown: Array[float] = []
	var clipped: Array[bool] = []
	for i in 4:
		# Each blow as soon as the last allows, the lunge of the last spent.
		while player._strike_cooldown > 0.0 or Vector2(player.velocity.x, player.velocity.z).length() > 1.0:
			await physics_frames(1)
		player._strike()
		combo.append(player._strike_combo)
		cooldown.append(player._strike_cooldown)
		clipped.append(anim.poser.is_clip_cutting())
	assert_eq(combo, [0, 1, 2, 3] as Array[int], "the combo advances through all four cuts")
	assert_eq(clipped, [true, false, false, false] as Array[bool], "the first cut is the clip, the rest keep their keys")
	for i in 3:
		assert_near(cooldown[i], rhythm, 0.001, "the next blow is as soon as ever (cut %d)" % i)
	assert_near(cooldown[3], rhythm * HumanoidPoser.CUT_X_TIME / HumanoidPoser.CUT_TIME, 0.001, "and the X as long as ever")
	var swing: Vector2 = anim.library.get_animation(&"cut_1").get_meta(SwingClip.META_SWING)
	assert_true(swing.y <= rhythm, "the clip's cut is over before the next blow is due (%.2f s of %.2f)" % [swing.y, rhythm])
