# Godot cache/import output (regenerated by `godot --import`)
game/.godot/

# Builds / exports
build/
export/

# Blender backups and Python caches
*.blend1
*.blend2
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
*.tmp
.vscode/
.idea/

# Local screenshot output (`make screenshots`)
screenshots/

# Godot lightmap-unwrap caches (regenerated on import)
*.unwrap_cache

# Mixamo downloads: usable in the game, but the raw files shouldn't be
# redistributed from a public repo. Remove these lines if the repo is private.
game/assets/animations/mixamo/*.fbx
game/assets/animations/mixamo/*.fbx.import
